---
/** Directory of every council calendar, by nation and region, with the October half term and the reading date. */
import PageLayout from '../../layouts/PageLayout.astro';
import Tool from '../../components/Tool.astro';
import { route } from '../../i18n/routes';
import { COUNCILS, councilRouteId, NATION_LABEL } from '../../lib/councils';
import { breakOf, rangeText, plainDate } from '../../lib/engine/calendar';
import { breadcrumbSchema } from '../../lib/seo';
import { LAST_UPDATED } from '../../data/site-config';
const lang = 'en';
const groups = new Map<string, typeof COUNCILS>();
for (const c of COUNCILS) { const g = c.nation === 'england' ? `England: ${c.region}` : NATION_LABEL[c.nation]; if (!groups.has(g)) groups.set(g, []); groups.get(g)!.push(c); }
const order = [...groups.keys()].sort();
const n28 = COUNCILS.filter((c) => c.years['2027-28'] && c.years['2027-28']!.status !== 'not-published').length;
---
<PageLayout title="Council Term Dates List: Every Calendar on Term Dates Finder" description={`All ${COUNCILS.length} council school calendars on Term Dates Finder by region, with October half term 2026, whether 2027-28 is out and the day each was read.`} lang={lang} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Councils', path: route('councils', lang) }])]} breadcrumbs={[{ label: 'Councils' }]}>
  <header class="mb-4"><h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Every council calendar on the site</h1>
  <p class="mt-2 text-navy-700">{COUNCILS.length} calendars, {n28} with 2027-28 published. Pick a council for its full dates, its own rules and the school open checker.</p></header>
  <div data-chrome class="mb-6"><Tool kind="checker" council="birmingham" /></div>
  <div class="prose prose-slate max-w-none">
    <p>Each line links to the council page. The October half term column is the quickest way to spot a council that breaks for two weeks, or one whose Scottish October holiday starts earlier. "Read" is the day we last opened the council's own calendar. Councils not yet on the site can be suggested from the contact page; we add them in order of the number of pupils they serve, and only from the council's own site.</p>
    <div data-sommaire class="not-prose">
      {order.map((g) => (
        <section class="mb-8">
          <h2 class="mb-2 font-serif text-xl font-semibold text-navy-900">{g}</h2>
          <div class="overflow-x-auto"><table class="journal w-full text-sm">
            <thead><tr><th scope="col" class="py-1 pr-3 text-left">Council</th><th scope="col" class="py-1 pr-3 text-left">October break 2026</th><th scope="col" class="py-1 pr-3 text-left">2027-28</th><th scope="col" class="py-1 text-left">Read</th></tr></thead>
            <tbody>{groups.get(g)!.map((c) => { const o = breakOf(c, '2026-27', 'october'); const y2 = c.years['2027-28']; return (
              <tr class="border-b border-navy-100"><td class="py-1.5 pr-3"><a class="underline" href={route(councilRouteId(c.slug), lang)}>{c.name}</a></td><td class="py-1.5 pr-3">{o ? rangeText(o.start, o.end) : 'n/a'}</td><td class="py-1.5 pr-3">{!y2 || y2.status === 'not-published' ? 'not yet' : y2.status === 'provisional' ? 'provisional' : 'published'}</td><td class="py-1.5">{plainDate(c.years['2026-27']?.source?.retrieved ?? LAST_UPDATED)}</td></tr>); })}</tbody>
          </table></div>
        </section>
      ))}
    </div>
  </div>
</PageLayout>
