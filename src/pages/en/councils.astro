---
/** Directory of every council calendar, by nation and region, with the October half term and the reading date. */
import PageLayout from '../../layouts/PageLayout.astro';
import Tool from '../../components/Tool.astro';
import Clamp from '../../components/Clamp.astro';
import { route } from '../../i18n/routes';
import { COUNCILS, councilRouteId, NATION_LABEL } from '../../lib/councils';
import { breakOf, rangeText, plainDate } from '../../lib/engine/calendar';
import { breadcrumbSchema, faqSchema, articleSchema } from '../../lib/seo';
import { LAST_UPDATED } from '../../data/site-config';
const lang = 'en';
const groups = new Map<string, typeof COUNCILS>();
for (const c of COUNCILS) { const g = c.nation === 'england' ? `England: ${c.region}` : NATION_LABEL[c.nation]; if (!groups.has(g)) groups.set(g, []); groups.get(g)!.push(c); }
const order = [...groups.keys()].sort();
const faqs = [
  { q: 'Why is my council not on the list?', a: 'We add councils in order of the number of pupils they serve and only once we have read the calendar on the council’s own website. If yours is missing, GOV.UK finds its term dates page from your postcode, and you can ask us to add it from the contact page so that the checker and the comparison include it.' },
  { q: 'Which council sets the dates in a two-tier area?', a: 'The county council, not the district or borough council, runs schools in two-tier areas such as Kent, Essex or Surrey. In London it is the borough, in metropolitan areas the metropolitan borough, and in unitary areas the single council. That is the calendar this site lists.' },
  { q: 'What does provisional mean in the 2027-28 column?', a: 'That the council has put the dates online as proposed or draft dates, for example during a consultation with schools, and could still change them. The checker shows them with a warning. When the council confirms the year, we update the page and the reading date.' },
];
const n28 = COUNCILS.filter((c) => c.years['2027-28'] && c.years['2027-28']!.status !== 'not-published').length;
---
<PageLayout title="Council Term Dates List: Every Calendar on When Is Half Term" description={`All ${COUNCILS.length} council school calendars on When Is Half Term by region, with October half term 2026, whether 2027-28 is out yet and the day each calendar was read.`} lang={lang} faqs={faqs} jsonLd={[articleSchema({ title: 'Every council calendar on the site', description: 'Directory of council school calendars', path: route('councils', lang), lang }), faqSchema(faqs, lang), breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Councils', path: route('councils', lang) }])]} breadcrumbs={[{ label: 'Councils' }]}>
  <header class="mb-4"><h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Every council calendar on the site</h1>
  <p class="mt-2 text-navy-700">{COUNCILS.length} calendars, {n28} with 2027-28 published.</p></header>
  <Clamp text={`Each line links to the council page, which gives both school years term by term, a day-by-day strip of the year, the bank holidays that fall in term, the rules the council states about INSET days and academies, and a comparison with its neighbours. The October half term column is the quickest way to spot a council that breaks for two weeks, or a Scottish council whose October holiday starts earlier. The 2027-28 column says whether the council has already published the following year, only as a provisional draft, or not at all. "Read" is the day we last opened the council's own calendar. Councils not yet on the site can be suggested from the contact page; we add them in order of the number of pupils they serve, and only from the council's own site.`} id="clamp-councils" class="mb-3" />
  <div data-chrome class="mb-6"><Tool kind="checker" council="birmingham" /></div>
  <div class="prose prose-slate max-w-none">

    <div data-sommaire class="not-prose">
      {order.map((g) => (
        <section class="mb-8">
          <h2 class="mb-2 font-serif text-xl font-semibold text-navy-900">{g}</h2>
          <div class="overflow-x-auto"><table class="journal w-full text-sm">
            <thead><tr><th scope="col" class="py-1 pr-3 text-left">Council</th><th scope="col" class="py-1 pr-3 text-left">October break 2026</th><th scope="col" class="py-1 pr-3 text-left">2027-28</th><th scope="col" class="py-1 text-left">Read</th></tr></thead>
            <tbody>{groups.get(g)!.map((c) => { const o = breakOf(c, '2026-27', 'october'); const y2 = c.years['2027-28']; return (
              <tr class="border-b border-navy-100"><td class="py-1.5 pr-3"><a class="underline" href={route(councilRouteId(c.slug), lang)}>{c.name}</a></td><td class="py-1.5 pr-3">{o ? rangeText(o.start, o.end) : 'n/a'}</td><td class="py-1.5 pr-3">{!y2 || y2.status === 'not-published' ? 'not yet' : y2.status === 'provisional' ? 'provisional' : 'published'}</td><td class="py-1.5">{plainDate(c.years['2026-27']?.source?.retrieved ?? LAST_UPDATED)}</td></tr>); })}</tbody>
          </table></div>
        </section>
      ))}
    </div>
  </div>
</PageLayout>
