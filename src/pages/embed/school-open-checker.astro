---
/** Embeddable checker (iframe): no navigation, noindex, out of the sitemap (astro.config). */
import '../../styles/global.css';
import TermChecker from '../../components/calc/TermChecker';
import { SITE_URL, SITE_NAMES } from '../../data/site-config';
import { COUNCILS, NAMES, toLite, councilBySlug, councilRouteId } from '../../lib/councils';
import { route } from '../../i18n/routes';
const c = councilBySlug('kent') ?? COUNCILS[0];
const hrefs = Object.fromEntries(COUNCILS.map((x) => [x.slug, `${SITE_URL}${route(councilRouteId(x.slug), 'en')}`]));
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Is school open? Term dates checker (widget)</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={`${SITE_URL}/en/`} />
  </head>
  <body class="bg-white p-2 text-navy-900">
    <TermChecker client:load initial={toLite(c)} names={NAMES} methodHref={`${SITE_URL}/en/method/`} councilHrefs={hrefs} />
    <p class="mt-2 text-center text-xs text-navy-600"><a href={`${SITE_URL}/en/`} target="_blank" rel="noopener" class="underline">{SITE_NAMES.en}</a> · council calendars, checked in your browser</p>
  </body>
</html>
