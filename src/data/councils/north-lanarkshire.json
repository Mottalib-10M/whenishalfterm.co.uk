    {"fact": "Teachers return on Monday 10 August 2026 for two in-service days and pupils return on Wednesday 12 August 2026.", "source": "https://www.northlanarkshire.gov.uk/schools-and-learning/school-holidays-and-term-dates"},
    {"fact": "North Lanarkshire places an in-service day on a Monday in November (16 November 2026 and 15 November 2027).", "source": "https://www.northlanarkshire.gov.uk/schools-and-learning/school-holidays-and-term-dates"},
    {"fact": "Schools close for the September weekend (a Friday and Monday) and again for the May weekend at the end of May.", "source": "https://www.northlanarkshire.gov.uk/schools-and-learning/school-holidays-and-term-dates"},
    {"fact": "Thursday 6 May 2027 is an in-service day to coincide with the Scottish Government elections.", "source": "https://www.northlanarkshire.gov.uk/schools-and-learning/school-holidays-and-term-dates"},
    {"fact": "In 2027-28 the school year starts unusually on a Thursday: teachers return on Thursday 12 August 2027 and pupils on Monday 16 August 2027.", "source": "https://www.northlanarkshire.gov.uk/schools-and-learning/school-holidays-and-term-dates"},
    {"fact": "Schools close at 2.30pm before the Christmas and spring breaks and at 1pm on the last day of the summer term.", "source": "https://www.northlanarkshire.gov.uk/schools-and-learning/school-holidays-and-term-dates"}
