  "appliesTo": "We publish school term and holiday dates for community and voluntary controlled schools in North Yorkshire.",
  "academyNote": "Some schools have slightly different term dates to those below, whilst others including academy, voluntary aided and foundation schools set all of their own dates.",
  "localFacts": [
    {
      "fact": "North Yorkshire publishes dates for community and voluntary controlled schools; academies, voluntary aided and foundation schools set all of their own dates.",
      "source": "https://www.northyorks.gov.uk/education-and-learning/education-and-learning/school-term-and-holiday-dates"
    },
    {
      "fact": "The council fixes three professional development training days in its calendar, and schools set a further two training dates of their own.",
      "source": "https://www.northyorks.gov.uk/education-and-learning/education-and-learning/school-term-and-holiday-dates"
    },
    {
      "fact": "In 2026-27 the fixed training days are Friday 23 October 2026, Monday 4 January 2027 and Monday 26 July 2027.",
      "source": "https://www.northyorks.gov.uk/education-and-learning/education-and-learning/school-term-and-holiday-dates"
    },
    {
      "fact": "The 2026-27 year starts on Monday 7 September 2026 and has an early February half term, 8 to 12 February 2027.",
      "source": "https://www.northyorks.gov.uk/education-and-learning/education-and-learning/school-term-and-holiday-dates"
    },
    {
      "fact": "The May half term starts on a Tuesday in both years, after the late May bank holiday (1 June 2027 and 30 May 2028).",
      "source": "https://www.northyorks.gov.uk/education-and-learning/education-and-learning/school-term-and-holiday-dates"
    },
    {
      "fact": "In 2027-28 the fixed training days are Monday 6 September 2027, Tuesday 4 January 2028 and Tuesday 25 July 2028.",
      "source": "https://www.northyorks.gov.uk/education-and-learning/education-and-learning/school-term-and-holiday-dates"
    },
    {
      "fact": "The council covers areas including Harrogate, Ripon, Scarborough, Whitby, Northallerton, Thirsk, Selby, Tadcaster, Malton, Pickering, Richmond and Skipton.",
      "source": "https://www.northyorks.gov.uk/education-and-learning/education-and-learning/school-term-and-holiday-dates"
    }
  ],
