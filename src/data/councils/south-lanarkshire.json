  "localFacts": [
    {"fact": "The 2026-27 school holiday and in-service dates were approved by the Education Resources Committee on Tuesday 9 September 2025, and the 2027-28 dates on Tuesday 30 June 2026.", "source": "https://www.southlanarkshire.gov.uk/secondary-school-information/school-holidays"},
    {"fact": "Pupils attend school for 190 days and teachers attend for 195 days.", "source": "https://www.southlanarkshire.gov.uk/secondary-school-information/school-holidays"},
    {"fact": "Lanark schools close for two extra days in June, Thursday 10 and Friday 11 June 2027, and Thursday 8 and Friday 9 June 2028.", "source": "https://www.southlanarkshire.gov.uk/secondary-school-information/school-holidays"},
    {"fact": "Schools close for a local holiday on the last Friday and Monday of May (28 and 31 May 2027).", "source": "https://www.southlanarkshire.gov.uk/secondary-school-information/school-holidays"},
    {"fact": "One in-service day falls on a Monday in November (9 November 2026 and 8 November 2027).", "source": "https://www.southlanarkshire.gov.uk/secondary-school-information/school-holidays"},
    {"fact": "In 2027-28 the year starts on a Friday: teachers return on Friday 13 August 2027 and pupils on Tuesday 17 August 2027.", "source": "https://www.southlanarkshire.gov.uk/secondary-school-information/school-holidays/2"},
    {"fact": "Schools close at 2.30pm before the Christmas and spring breaks and at 1pm for the summer break.", "source": "https://www.southlanarkshire.gov.uk/secondary-school-information/school-holidays"}
