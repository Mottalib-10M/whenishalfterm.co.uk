  "localFacts": [
    {
      "fact": "Waltham Forest publishes its term dates as a colour-coded 'holiday pattern' calendar, marking school days, bank holidays and school closures.",
      "source": "https://www.walthamforest.gov.uk/sites/default/files/2025-10/Term%20Dates%202026-27%20%283%29.pdf"
    },
    {
      "fact": "The 2026-27 calendar marks Tuesday 1 September 2026 as a school closure, so the autumn term opens on Wednesday 2 September.",
      "source": "https://www.walthamforest.gov.uk/sites/default/files/2025-10/Term%20Dates%202026-27%20%283%29.pdf"
    },
    {
      "fact": "Both 2026-27 and 2027-28 total 195 school days, counted per half term (38, 35, 30, 24, 34 and 34 in 2026-27).",
      "source": "https://www.walthamforest.gov.uk/sites/default/files/2025-10/Term%20Dates%202026-27%20%283%29.pdf"
    },
    {
      "fact": "In 2027-28 the half terms count 38, 35, 29, 30, 28 and 35 days, with the summer half term starting on the spring bank holiday, Monday 29 May 2028.",
      "source": "https://www.walthamforest.gov.uk/sites/default/files/2025-10/Term%20Dates%202027-28.pdf"
    },
    {
      "fact": "The council page was last updated on 4 November 2025, with a next review due on 13 October 2026.",
      "source": "https://www.walthamforest.gov.uk/schools-education-and-learning/school-term-and-closure-dates/school-holiday-and-term-dates"
    }
  ],
