  "localFacts": [
    {
      "fact": "Oxfordshire names one countywide 'available for work' or INSET day each year: 1 September 2026 and 3 September 2027.",
      "source": "https://www.oxfordshire.gov.uk/schools/term-dates-and-holidays"
    },
    {
      "fact": "Schools set four more INSET days themselves; the council calendar counts them inside the 195 pupil days shown.",
      "source": "https://www.oxfordshire.gov.uk/sites/default/files/file/school/Termdates2026-27.pdf"
    },
    {
      "fact": "Term dates are set by the council after consultation with schools, neighbouring authorities and groups representing teaching and other staff, among others.",
      "source": "https://www.oxfordshire.gov.uk/schools/term-dates-and-holidays"
    },
    {
      "fact": "In 2027-28 the autumn term starts late for pupils, on Monday 6 September 2027, after the countywide INSET day on Friday 3 September.",
      "source": "https://www.oxfordshire.gov.uk/sites/default/files/file/school/Termdates2027-28.pdf"
    },
    {
      "fact": "In 2027-28 the spring term runs to 7 April 2028 and the Easter holiday is 10 to 21 April 2028, around Easter Sunday 16 April.",
      "source": "https://www.oxfordshire.gov.uk/schools/term-dates-and-holidays"
    },
    {
      "fact": "Oxfordshire calls the May break the 'Late Spring half-term'.",
      "source": "https://www.oxfordshire.gov.uk/schools/term-dates-and-holidays"
    }
  ],
