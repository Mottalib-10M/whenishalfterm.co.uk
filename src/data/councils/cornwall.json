  "localFacts": [
    {"fact": "Cornwall publishes the number of days in each term: 72 in the autumn, 54 in the spring and 69 in the summer of 2026-27, a total of 195.", "source": "https://www.cornwall.gov.uk/termdates"},
    {"fact": "Maintained schools may take five INSET days during each academic year, and parents are asked to contact their school for how these are distributed.", "source": "https://www.cornwall.gov.uk/termdates"},
    {"fact": "The council publishes each year's term dates as a PDF and as an iCalendar (ics) file that works with most phones and calendar apps.", "source": "https://www.cornwall.gov.uk/termdates"},
    {"fact": "In 2027-28 the autumn term runs to Wednesday 22 December 2027 and the spring term starts on Thursday 6 January 2028.", "source": "https://www.cornwall.gov.uk/termdates"},
    {"fact": "Cornwall's summer term ends on Friday 23 July 2027 and Friday 21 July 2028.", "source": "https://www.cornwall.gov.uk/termdates"},
