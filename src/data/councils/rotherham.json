  "localFacts": [
    {
      "fact": "Rotherham publishes each school year on its own page, with the bank holidays of that year listed under the term dates.",
      "source": "https://www.rotherham.gov.uk/schools-schooling/school-term-dates"
    },
    {
      "fact": "The 2026-27 spring term ends on Thursday 25 March 2027, the day before Good Friday, and the summer term starts on Monday 12 April 2027.",
      "source": "https://www.rotherham.gov.uk/schools-schooling/school-term-dates/2"
    },
    {
      "fact": "In both years the May half term starts on a Tuesday, after the spring bank holiday: 1 to 4 June 2027 and 30 May to 2 June 2028.",
      "source": "https://www.rotherham.gov.uk/schools-schooling/school-term-dates"
    },
    {
      "fact": "The 2026-27 year ends on Wednesday 21 July 2027 and the 2027-28 year starts on Wednesday 1 September 2027.",
      "source": "https://www.rotherham.gov.uk/schools-schooling/school-term-dates"
    },
    {
      "fact": "In 2028 the spring term ends on Friday 31 March and the summer term starts on Tuesday 18 April, the day after Easter Monday.",
      "source": "https://www.rotherham.gov.uk/schools-schooling/school-term-dates"
    },
    {
      "fact": "The 2027-28 page lists Monday 3 January 2028 as the New Year's Day bank holiday, and the spring term starts on Tuesday 4 January.",
      "source": "https://www.rotherham.gov.uk/schools-schooling/school-term-dates"
    }
  ],
