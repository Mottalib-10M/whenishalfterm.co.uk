  "localFacts": [
    {"fact": "Teachers return two days before pupils each August: in 2026 teachers return on Monday 10 August for two in-service days and pupils return on Wednesday 12 August.", "source": "https://glasgow.gov.uk/article/4276/School-Term-Dates"},
    {"fact": "Glasgow schools close for the September weekend, a Friday and the following Monday (25 and 28 September 2026).", "source": "https://glasgow.gov.uk/article/4276/School-Term-Dates"},
    {"fact": "The October week is preceded by an in-service day on the Friday, so pupils are off from Friday 9 October to Friday 16 October 2026.", "source": "https://glasgow.gov.uk/article/4276/School-Term-Dates"},
    {"fact": "The February mid term break is three days for pupils: two holidays followed by an in-service day on the Wednesday.", "source": "https://glasgow.gov.uk/article/4276/School-Term-Dates"},
    {"fact": "An in-service day on Thursday 6 May 2027 is set to coincide with elections, and the council says it may be subject to change.", "source": "https://glasgow.gov.uk/article/4276/School-Term-Dates"},
    {"fact": "Schools close early on the last day before the Christmas and spring holidays (2.30 pm) and at 1.00 pm on the last day of the summer term.", "source": "https://glasgow.gov.uk/article/4276/School-Term-Dates"},
    {"fact": "The council already gives Monday 14 August 2028 as the proposed date for teachers to return after the 2027-28 year.", "source": "https://glasgow.gov.uk/article/4276/School-Term-Dates"}
  ],
