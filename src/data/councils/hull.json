    {
      "fact": "The 2026-27 year starts later than in many areas, on Monday 7 September 2026.",
      "source": "https://www.hull.gov.uk/schools-2/school-holidays-term-dates/2"
    },
    {
      "fact": "In 2026-27 the February half term comes early, from Monday 8 to Friday 12 February 2027, and the Easter holiday runs from Monday 22 March to Friday 2 April 2027.",
      "source": "https://www.hull.gov.uk/schools-2/school-holidays-term-dates/2"
    },
    {
      "fact": "Schools close for the summer on Monday 26 July 2027, a Monday, at the end of 2026-27.",
      "source": "https://www.hull.gov.uk/schools-2/school-holidays-term-dates/2"
    },
    {
      "fact": "After Christmas 2027 schools reopen on Wednesday 5 January 2028.",
      "source": "https://www.hull.gov.uk/schools-2/school-holidays-term-dates/3"
    },
    {
      "fact": "In 2028 the Easter holiday runs from Monday 10 April to Friday 21 April, and the 2027-28 year ends on Wednesday 26 July 2028.",
      "source": "https://www.hull.gov.uk/schools-2/school-holidays-term-dates/3"
    }
