  "type": "unitary",
  "appliesTo": "The Local Authority is responsible for setting dates for community and controlled schools, which are recommended for adoption by voluntary-aided, foundation, academies and free schools.",
  "academyNote": "In academies and free schools the duty lies with the governing board, or with the trust, depending on their agreements on delegation of responsibilities. Clusters of schools may agree minor local variations with the Local Authority.",
  "localFacts": [
    {
      "fact": "Cheshire East's term dates are for guidance only; some schools set their own dates or agree minor local variations with the council.",
      "source": "https://www.cheshireeast.gov.uk/schools/school_term_dates_for_cheshire.aspx"
    },
    {
      "fact": "Autumn half term is set as the full week before the first Tuesday in November.",
      "source": "https://www.cheshireeast.gov.uk/schools/school_term_dates_for_cheshire.aspx"
    },
    {
      "fact": "The Whitsun half term is one week, unless a primary school's governing board agrees an extra week, in which case its summer term ends one week later.",
      "source": "https://www.cheshireeast.gov.uk/schools/school_term_dates_for_cheshire.aspx"
    },
    {
      "fact": "Governing boards designate all five INSET days, with no more than two days in a row.",
      "source": "https://www.cheshireeast.gov.uk/schools/school_term_dates_for_cheshire.aspx"
    },
    {
      "fact": "Schools are expected to publish their term dates on their website at least two school years in advance.",
      "source": "https://www.cheshireeast.gov.uk/schools/school_term_dates_for_cheshire.aspx"
    },
    {
      "fact": "Each year is published with the number of open days: 74, 54 and 67 days in 2026/2027, and 73, 59 and 63 days in 2027/2028.",
      "source": "https://www.cheshireeast.gov.uk/schools/school_term_dates_for_cheshire.aspx"
    }
  ],
