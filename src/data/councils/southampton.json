  "localFacts": [
    {
      "fact": "Southampton's dates cover all local authority maintained and voluntary controlled schools in the city.",
      "source": "https://www.southampton.gov.uk/schools-learning/school-information/school-term-dates/school-year-calendar-2026-27/"
    },
    {
      "fact": "Each Southampton school year has 190 teaching days and five staff training days.",
      "source": "https://www.southampton.gov.uk/schools-learning/school-information/school-term-dates/school-year-calendar-2026-27/"
    },
    {
      "fact": "Schools close to pupils on several days a year for INSET days, and parents must contact the schools directly or check their websites for these dates.",
      "source": "https://www.southampton.gov.uk/schools-learning/school-information/school-term-dates/"
    },
    {
      "fact": "The council publishes a separate school year calendar page for each year, which can be printed or saved as a PDF.",
      "source": "https://www.southampton.gov.uk/schools-learning/school-information/school-term-dates/school-year-calendar-2027-28/"
    },
    {
      "fact": "Southampton names its six half terms Autumn one, Autumn two, Spring one, Spring two, Summer one and Summer two.",
      "source": "https://www.southampton.gov.uk/schools-learning/school-information/school-term-dates/school-year-calendar-2027-28/"
    }
  ],
