  "localFacts": [
    {
      "fact": "Bromley's autumn term starts in late August: Wednesday 26 August 2026 and Thursday 26 August 2027, with the August bank holiday falling inside the term.",
      "source": "https://www.bromley.gov.uk/schools-colleges/school-term-dates/3"
    },
    {
      "fact": "In return the October half term lasts two weeks: Monday 19 to Friday 30 October 2026, and Monday 18 to Friday 29 October 2027.",
      "source": "https://www.bromley.gov.uk/schools-colleges/school-term-dates/3"
    },
    {
      "fact": "Term dates are set following consultation with neighbouring local education authorities and staff association representatives.",
      "source": "https://www.bromley.gov.uk/schools-colleges/school-term-dates"
    },
    {
      "fact": "There are 195 teacher days a year, of which five week-days are staff development days chosen by the head teacher, leaving 190 days for pupils.",
      "source": "https://www.bromley.gov.uk/schools-colleges/school-term-dates"
    },
    {
      "fact": "The local authority sets dates for maintained and voluntary controlled schools; academies, foundation, voluntary aided and free schools can set their own.",
      "source": "https://www.bromley.gov.uk/schools-colleges/school-term-dates"
    },
    {
      "fact": "The induction day for Year 6 pupils moving to secondary school in autumn 2026 is Tuesday 7 July 2026; for autumn 2027 the council is proposing Tuesday 6 July 2027.",
