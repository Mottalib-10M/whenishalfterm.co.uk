  "appliesTo": "The council sets the school term dates for community and voluntary controlled schools.",
  "academyNote": "The governing bodies of academies and voluntary aided schools set their own term dates but are encouraged to follow a similar pattern. Some voluntary-aided, foundation, or academy schools may be slightly different.",
  "localFacts": [
    {
      "fact": "Salford's Easter break is always the first two full weeks in April, regardless of where Easter itself falls.",
      "source": "https://www.salford.gov.uk/schools-and-learning/school-holidays/information-on-school-term-dates/"
    },
    {
      "fact": "Schools close on Good Friday and Easter Monday even when they fall in term time, as on 26 and 29 March 2027.",
      "source": "https://www.salford.gov.uk/schools-and-learning/school-holidays/information-on-school-term-dates/"
    },
    {
      "fact": "Autumn half term is always the last full week in October and spring half term the third full week in February.",
      "source": "https://www.salford.gov.uk/schools-and-learning/school-holidays/information-on-school-term-dates/"
    },
    {
      "fact": "All terms start on a Monday, or on a Tuesday when a bank holiday makes it necessary.",
      "source": "https://www.salford.gov.uk/schools-and-learning/school-holidays/information-on-school-term-dates/"
    },
    {
      "fact": "Schools choose their five inset days, with no more than two days in a row, and may use twilight sessions instead.",
      "source": "https://www.salford.gov.uk/schools-and-learning/school-holidays/information-on-school-term-dates/"
    },
    {
      "fact": "The Salford scheme totals 190 days, the statutory number.",
      "source": "https://www.salford.gov.uk/schools-and-learning/school-holidays/information-on-school-term-dates/"
    },
    {
      "fact": "The 2027 to 2028 summer term ends on Wednesday 26 July 2028, later than most neighbouring councils.",
      "source": "https://www.salford.gov.uk/schools-and-learning/school-holidays/"
    }
  ],
