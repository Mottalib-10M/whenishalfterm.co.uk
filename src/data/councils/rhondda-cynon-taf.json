  "academyNote": "Tuesday 1 Sept 2026 will be a designated INSET day for all LA maintained schools. The remaining INSET days will be at the discretion of each individual school following appropriate consultation with staff.",
  "localFacts": [
    {
      "fact": "Rhondda Cynon Taf names one INSET day for every school it maintains, on the first day of September, and leaves the remaining four to each head teacher after consulting staff.",
      "source": "https://www.rctcbc.gov.uk/EN/Resident/SchoolsandLearning/Schooltermdatesinsetdaysandemergencies/Schooltermdates.aspx"
    },
    {
      "fact": "Every school in the borough closes on Monday 3 May 2027 for the May Day bank holiday, which the council lists separately from the half terms.",
      "source": "https://www.rctcbc.gov.uk/EN/Resident/SchoolsandLearning/Schooltermdatesinsetdaysandemergencies/Schooltermdates.aspx"
    },
    {
      "fact": "Its 2026-27 summer term ends on a Tuesday, 20 July 2027, and the 2027-28 year finishes on Thursday 20 July 2028.",
      "source": "https://www.rctcbc.gov.uk/EN/Resident/SchoolsandLearning/Schooltermdatesinsetdaysandemergencies/Schooltermdates.aspx"
    },
    {
      "fact": "Over Christmas 2027 the holiday is extended to Monday 3 January 2028, the New Year bank holiday, and pupils return on Tuesday 4 January.",
      "source": "https://www.rctcbc.gov.uk/EN/Resident/SchoolsandLearning/Schooltermdatesinsetdaysandemergencies/Schooltermdates.aspx"
    },
    {
      "fact": "The calendar matches Carmarthenshire's week for week in both years, so families moving between the two counties keep the same holidays.",
      "source": "https://www.rctcbc.gov.uk/EN/Resident/SchoolsandLearning/Schooltermdatesinsetdaysandemergencies/Schooltermdates.aspx"
    }
  ],
