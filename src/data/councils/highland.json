  "localFacts": [
    {"fact": "Highland schools have two week holidays in October, at Christmas and New Year, and at Easter, and a summer holiday of 6 to 8 weeks.", "source": "https://www.highland.gov.uk/schools/school-term-dates"},
    {"fact": "One in-service day falls in mid September (Monday 14 September 2026 and Monday 13 September 2027) instead of a September weekend holiday.", "source": "https://www.highland.gov.uk/schools/school-term-dates/2"},
    {"fact": "Holiday dates are inclusive: for holidays from 14 to 21 October, pupils return on 22 October.", "source": "https://www.highland.gov.uk/schools/school-term-dates/2"},
    {"fact": "The February break is two days (a Monday and Tuesday) followed by an in-service day on the Wednesday.", "source": "https://www.highland.gov.uk/schools/school-term-dates/2"},
    {"fact": "Term 4 ends on a Thursday, with the summer holidays starting on Friday 2 July 2027 and Friday 30 June 2028.", "source": "https://www.highland.gov.uk/schools/school-term-dates/3"},
    {"fact": "The council offers a printable copy of the calendar and a way to add the dates to a personal calendar.", "source": "https://www.highland.gov.uk/schools/school-term-dates"}
