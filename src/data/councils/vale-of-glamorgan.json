  "localFacts": [
    {
      "fact": "The Vale of Glamorgan designates three INSET days for its maintained schools in 2026-27: Tuesday 1 September 2026 and Monday 19 and Tuesday 20 July 2027, leaving two to each school.",
      "source": "https://www.valeofglamorgan.gov.uk/en/living/schools/School-Term-Dates.aspx"
    },
    {
      "fact": "The two July INSET days may instead be taken at another time, for example as twilight sessions, the council says, so pupils may or may not be in school on 19 and 20 July 2027.",
      "source": "https://www.valeofglamorgan.gov.uk/en/living/schools/School-Term-Dates.aspx"
    },
    {
      "fact": "The council publishes the number of school days per term: 74 in autumn 2026, 50 in spring 2027 and 71 in summer 2027.",
      "source": "https://www.valeofglamorgan.gov.uk/en/living/schools/School-Term-Dates.aspx"
    },
    {
      "fact": "For 2027-28 only Wednesday 1 September 2027 is a designated INSET day; the remaining four are left to schools.",
      "source": "https://www.valeofglamorgan.gov.uk/en/living/schools/School-Term-Dates.aspx"
    },
    {
      "fact": "All schools close on Monday 3 May 2027 and Monday 1 May 2028 for the May Day bank holiday.",
      "source": "https://www.valeofglamorgan.gov.uk/en/living/schools/School-Term-Dates.aspx"
    }
  ],
