  "localFacts": [
    {
      "fact": "Derbyshire's school year starts later than most of England: on Friday 4 September 2026 and Monday 6 September 2027.",
      "source": "https://www.derbyshire.gov.uk/education/schools/term-dates-school-holidays/school-term-dates-and-holidays.aspx"
    },
    {
      "fact": "The summer term runs late to compensate, ending on Monday 26 July 2027 and Monday 24 July 2028.",
      "source": "https://www.derbyshire.gov.uk/education/schools/term-dates-school-holidays/school-term-dates-and-holidays.aspx"
    },
    {
      "fact": "The council's calendars total 195 days, including 5 days to be taken as INSET days chosen by schools.",
      "source": "https://www.derbyshire.gov.uk/site-elements/documents/pdf/education/schools/term-dates-school-holidays/school-term-dates-2026-to-2027.pdf"
    },
    {
      "fact": "In 2027-28 the autumn term runs to Wednesday 22 December 2027 and the spring term restarts on Thursday 6 January 2028.",
      "source": "https://www.derbyshire.gov.uk/education/schools/term-dates-school-holidays/school-term-dates-and-holidays.aspx"
    },
    {
      "fact": "The council lists the number of days in each half term, for example 36, 35, 30, 24, 34 and 36 days in 2026-27.",
      "source": "https://www.derbyshire.gov.uk/education/schools/term-dates-school-holidays/school-term-dates-and-holidays.aspx"
    },
    {
      "fact": "Derbyshire already publishes term dates up to 2029-30, with a calendar PDF for each year.",
      "source": "https://www.derbyshire.gov.uk/education/schools/term-dates-school-holidays/school-term-dates-and-holidays.aspx"
    }
