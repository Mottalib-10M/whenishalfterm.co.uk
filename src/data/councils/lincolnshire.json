  "appliesTo": "We set the term dates for all community and voluntary-controlled schools.",
  "academyNote": "These dates may not apply to voluntary-aided schools, foundation schools, free schools or academies. Check your school's website to confirm.",
  "localFacts": [
    {
      "fact": "Lincolnshire numbers its year in six terms and gives each holiday from the Saturday to the Sunday or Monday before school restarts.",
      "source": "https://www.lincolnshire.gov.uk/school-attendance/school-term-times"
    },
    {
      "fact": "Lincolnshire's school year starts later than many areas: Thursday 3 September 2026 and Monday 6 September 2027.",
      "source": "https://www.lincolnshire.gov.uk/school-attendance/school-term-times"
    },
    {
      "fact": "Schools return a day after the New Year bank holiday: on Tuesday 5 January 2027 and Wednesday 5 January 2028.",
      "source": "https://www.lincolnshire.gov.uk/school-attendance/school-term-times"
    },
    {
      "fact": "The Easter holiday is long and includes the week after Easter: 26 March to 13 April 2027, with term 5 starting on Wednesday 14 April 2027.",
      "source": "https://www.lincolnshire.gov.uk/school-attendance/school-term-times"
    },
    {
      "fact": "In October 2023 the council changed the 2024-25 term 5 dates for all maintained schools, starting term 5 on Wednesday 23 April 2025, because GCSE exams fell on a non-teaching day.",
      "source": "https://www.lincolnshire.gov.uk/school-attendance/school-term-times"
    },
    {
      "fact": "The council lists the end of each summer holiday as tbc until the next year's dates are set.",
      "source": "https://www.lincolnshire.gov.uk/school-attendance/school-term-times"
    }
  ],
