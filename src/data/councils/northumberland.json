  "localFacts": [
    {
      "fact": "Northumberland publishes a list of teacher training days school by school, grouped by school partnership, with a separate list for special schools.",
      "source": "https://www.northumberland.gov.uk/education-skills/schools/school-term-and-holiday-dates"
    },
    {
      "fact": "In the 2026-27 training day list many schools share 1 September 2026 as a training day, and several replace some days with commuted twilight sessions.",
      "source": "https://www.northumberland.gov.uk/NorthumberlandCountyCouncil/media/Schools-Media/Teacher-Training-Days-2026-27.pdf"
    },
    {
      "fact": "The 2026-27 calendar shows 195 term time days, with 5 used by schools as non-teaching days.",
      "source": "https://www.northumberland.gov.uk/NorthumberlandCountyCouncil/media/Document-store/Term-Dates-2026-2027.pdf"
    },
    {
      "fact": "The 2027-28 calendar shows 192 days: 2 are non-teaching days and schools must find 3 further non-teaching days outside the term dates.",
      "source": "https://www.northumberland.gov.uk/NorthumberlandCountyCouncil/media/Document-store/School%20admissions/School%20Holiday%20and%20Term%20Dates%202027-28.pdf"
    },
    {
      "fact": "Schools must take account of closures for local or Parliamentary elections when setting their 2027-28 non-teaching days.",
      "source": "https://www.northumberland.gov.uk/NorthumberlandCountyCouncil/media/Document-store/School%20admissions/School%20Holiday%20and%20Term%20Dates%202027-28.pdf"
    },
    {
      "fact": "The council reminds parents they can be fined for taking children out of school in term time without consent, and that a family holiday is unlikely to be authorised.",
      "source": "https://www.northumberland.gov.uk/education-skills/schools/school-term-and-holiday-dates"
    }
  ],
