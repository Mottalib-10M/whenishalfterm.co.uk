  "appliesTo": "School term and holiday dates can vary because every school has 5 staff development days to use a year on dates they choose. Check your school's website or contact them for confirmation of dates.",
  "academyNote": "",
  "localFacts": [
    {
      "fact": "Every Dorset school has five staff development days a year to use on dates it chooses, so parents are asked to confirm dates with the school.",
      "source": "https://www.dorsetcouncil.gov.uk/w/school-term-holiday-dates"
    },
    {
      "fact": "The council lists bank holidays separately from school holidays: the Easter holidays are given as 30 March to 9 April 2027, after Good Friday and Easter Monday.",
      "source": "https://www.dorsetcouncil.gov.uk/w/school-term-holiday-dates"
    },
    {
      "fact": "The summer half term is listed from the Tuesday (1 June 2027, 30 May 2028), as the Monday is the spring bank holiday.",
      "source": "https://www.dorsetcouncil.gov.uk/w/school-term-holiday-dates"
    },
    {
      "fact": "The summer term ends on Wednesday 21 July 2027 and Friday 21 July 2028.",
      "source": "https://www.dorsetcouncil.gov.uk/w/school-term-holiday-dates"
    },
    {
      "fact": "The 2026-27 autumn term starts on Tuesday 1 September 2026, and the 2027-28 autumn term on Wednesday 1 September 2027.",
      "source": "https://www.dorsetcouncil.gov.uk/w/school-term-holiday-dates"
    },
    {
      "fact": "Each year's dates can be downloaded and printed from the council page.",
      "source": "https://www.dorsetcouncil.gov.uk/w/school-term-holiday-dates"
    }
  ],
