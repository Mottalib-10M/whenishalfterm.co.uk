  "academyNote": "Shropshire-maintained schools and academies are required to allocate five professional development (PD) days for staff across the academic year. Please contact your child's school, directly, to confirm the exact dates of the school term, PD days and holidays.",
  "localFacts": [
    {
      "fact": "Shropshire calls staff training days professional development (PD) days and says schools may be closed to pupils on these five days.",
      "source": "https://next.shropshire.gov.uk/schools-and-education/term-time-and-holiday-dates/"
    },
    {
      "fact": "For 2026-27 the council lists two PD days: Tuesday 1 September 2026 and Monday 4 January 2027.",
      "source": "https://next.shropshire.gov.uk/schools-and-education/term-time-and-holiday-dates/"
    },
    {
      "fact": "The 2026-27 summer term ends on Wednesday 21 July 2027, a later finish than Shropshire's 2025-26 summer term, which ended on 17 July 2026.",
      "source": "https://next.shropshire.gov.uk/schools-and-education/term-time-and-holiday-dates/"
    },
    {
      "fact": "Shropshire publishes a 2027-28 term dates calendar as a PDF alongside the web page.",
      "source": "https://next.shropshire.gov.uk/schools-and-education/term-time-and-holiday-dates/"
    },
    {
      "fact": "Parents who need to take a child out of school in term time are told to contact the school before booking travel, as permission may not be granted.",
      "source": "https://next.shropshire.gov.uk/schools-and-education/term-time-and-holiday-dates/"
    }
