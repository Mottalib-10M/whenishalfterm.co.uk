  "localFacts": [
    {
      "fact": "Nottingham City Council says it keeps a legal responsibility to set term and holiday dates and aims for stability and consistency across city maintained schools and with academies where possible.",
      "source": "https://www.nottinghamcity.gov.uk/terms"
    },
    {
      "fact": "The council recommends an INSET day at the start of each year: Tuesday 1 September 2026 and Wednesday 1 September 2027; the other INSET days are decided by each school.",
      "source": "https://www.nottinghamcity.gov.uk/terms"
    },
    {
      "fact": "Nottingham City has a two-week October half term: Monday 19 to Friday 30 October 2026, and Monday 18 to Friday 29 October 2027.",
      "source": "https://www.nottinghamcity.gov.uk/terms"
    },
    {
      "fact": "The summer term ends late, on Wednesday 28 July 2027 and Wednesday 26 July 2028.",
      "source": "https://www.nottinghamcity.gov.uk/terms"
    },
    {
      "fact": "In 2027-28 the autumn term ends on Tuesday 21 December 2027 and the summer term starts on Tuesday 18 April 2028, the day after Easter Monday.",
      "source": "https://www.nottinghamcity.gov.uk/terms"
    },
    {
      "fact": "The council already lists term dates up to 2029-30.",
      "source": "https://www.nottinghamcity.gov.uk/terms"
    }
