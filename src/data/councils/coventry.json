  "localFacts": [
    {
      "fact": "Coventry sets its term dates up to three years in advance.",
      "source": "https://www.coventry.gov.uk/schools-schooling/school-term-dates/print"
    },
    {
      "fact": "The local authority sets the dates each year in consultation with parents, headteachers, governing bodies, professional associations, Diocesan Boards of Education, FE colleges and trade unions.",
      "source": "https://www.coventry.gov.uk/schools-schooling/school-term-dates/print"
    },
    {
      "fact": "Coventry's 2026-27 autumn term starts on Wednesday 2 September 2026, a day later than several neighbouring West Midlands councils.",
      "source": "https://www.coventry.gov.uk/schools-schooling/school-term-dates/print"
    },
    {
      "fact": "A total of 195 days are defined as school days: pupils attend for 190 and each school sets its own 5 staff training days.",
      "source": "https://www.coventry.gov.uk/schools-schooling/school-term-dates/print"
    },
    {
      "fact": "The council offers each year as a printable calendar and as an ics file to add to a digital calendar.",
      "source": "https://www.coventry.gov.uk/schools-schooling/school-term-dates/print"
    },
    {
      "fact": "In 2027-28 the summer term ends on Thursday 20 July 2028, with summer holidays beginning on Friday 21 July 2028.",
      "source": "https://www.coventry.gov.uk/schools-schooling/school-term-dates/print"
    },
    {
      "fact": "Holiday activities are listed in the Coventry Family Information Directory what's on section.",
      "source": "https://www.coventry.gov.uk/schools-schooling/school-term-dates/print"
    }
  ],
