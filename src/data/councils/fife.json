  "localFacts": [
    {"fact": "Fife schools have a two week autumn holiday in October, listed as lasting 12 days (Monday 12 to Friday 23 October 2026).", "source": "https://www.fife.gov.uk/kb/docs/articles/education2/schools-in-fife/school-holidays"},
    {"fact": "The council publishes four terms (autumn, winter, spring and summer) rather than three, with the winter term running from the end of the October holiday to Christmas.", "source": "https://www.fife.gov.uk/kb/docs/articles/education2/schools-in-fife/school-holidays"},
    {"fact": "The February break is two additional holiday days on a Thursday and Friday, preceded by an in-service day on the Wednesday.", "source": "https://www.fife.gov.uk/kb/docs/articles/education2/schools-in-fife/school-holidays"},
    {"fact": "Fife has an additional one day holiday on the first Monday of June (7 June 2027, 5 June 2028) as well as the May Day holiday.", "source": "https://www.fife.gov.uk/kb/docs/articles/education2/schools-in-fife/school-holidays"},
    {"fact": "One in-service day falls in November (Friday 13 November 2026 and Friday 12 November 2027).", "source": "https://www.fife.gov.uk/kb/docs/articles/education2/schools-in-fife/school-holidays"},
    {"fact": "The Christmas holidays start on 23 December and pupils return on 6 January in both 2026-27 and 2027-28.", "source": "https://www.fife.gov.uk/kb/docs/articles/education2/schools-in-fife/school-holidays"},
    {"fact": "All holiday dates on the council page are inclusive, and each holiday can be added to a calendar from the page.", "source": "https://www.fife.gov.uk/kb/docs/articles/education2/schools-in-fife/school-holidays"}
  ],
