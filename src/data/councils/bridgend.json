  "localFacts": [
    {
      "fact": "Bridgend's page gives each term as a start, a half term and an end, for 2025-26, 2026-27 and 2027-28 on one page.",
      "source": "https://www.bridgend.gov.uk/residents/schools-and-education/term-dates/"
    },
    {
      "fact": "The autumn term 2026 starts on Tuesday 1 September, and the summer term 2027 ends on Tuesday 20 July.",
      "source": "https://www.bridgend.gov.uk/residents/schools-and-education/term-dates/"
    },
    {
      "fact": "The spring term 2027 ends on Friday 19 March, a week before Good Friday, so pupils are back on Monday 5 April.",
      "source": "https://www.bridgend.gov.uk/residents/schools-and-education/term-dates/"
    },
    {
      "fact": "In 2027-28 the spring term runs to Friday 7 April 2028 and the summer term starts on 24 April, after the late Easter.",
      "source": "https://www.bridgend.gov.uk/residents/schools-and-education/term-dates/"
    },
    {
      "fact": "The page does not list INSET days: each school publishes its own.",
      "source": "https://www.bridgend.gov.uk/residents/schools-and-education/term-dates/"
    }
  ],
