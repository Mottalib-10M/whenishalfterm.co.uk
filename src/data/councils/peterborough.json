  "localFacts": [
    {"fact": "Peterborough City Council sets term dates for local authority maintained schools only; foundation, trust, voluntary aided schools and academies set their own.", "source": "https://www.peterborough.gov.uk/schools-and-education/term-dates"},
    {"fact": "The council publishes the number of school days in each half term, for example 39 days from Tuesday 1 September to Friday 23 October 2026.", "source": "https://www.peterborough.gov.uk/schools-and-education/term-dates"},
    {"fact": "Schools have five training days to take at their discretion, so the published days total 195 for teachers and 190 for pupils.", "source": "https://www.peterborough.gov.uk/schools-and-education/term-dates"},
