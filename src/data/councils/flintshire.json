  "localFacts": [
    {
      "fact": "Flintshire explains that Welsh Ministers used the Education (Wales) Act 2014 to harmonise term dates for all maintained schools, and can direct councils and the governing bodies of voluntary aided and foundation schools whose dates are not harmonised.",
      "source": "https://www.flintshire.gov.uk/en/Resident/Popular/School-Holidays-Training-Days.aspx"
    },
    {
      "fact": "The council no longer recommends set training days: each school sets its own five, and pupils are not admitted on them.",
      "source": "https://www.flintshire.gov.uk/en/Resident/Popular/School-Holidays-Training-Days.aspx"
    },
    {
      "fact": "Flintshire's 2027-28 calendar differs from its neighbours': the autumn term runs to Wednesday 22 December 2027 and the spring term starts on Thursday 6 January 2028.",
      "source": "https://www.flintshire.gov.uk/en/Resident/Popular/School-Holidays-Training-Days.aspx"
    },
    {
      "fact": "The summer term 2028 ends on Wednesday 19 July 2028, a day earlier than in the south Wales councils on this site.",
      "source": "https://www.flintshire.gov.uk/en/Resident/Popular/School-Holidays-Training-Days.aspx"
    },
    {
      "fact": "In 2026-27 Flintshire's dates match the common Welsh calendar: February half term 8 to 12 February 2027 and the spring term ending on 19 March.",
      "source": "https://www.flintshire.gov.uk/en/Resident/Popular/School-Holidays-Training-Days.aspx"
    }
  ],
