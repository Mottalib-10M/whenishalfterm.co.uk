  "localFacts": [
    {
      "fact": "Plymouth's calendar asks each school to allocate occasional days from within the term dates, and suggests placing them so that terms are of equal length.",
      "source": "https://www.plymouth.gov.uk/sites/default/files/2026-08/School-Term-Dates-2026-2027-V3.pdf"
    },
    {
      "fact": "In February 2027 the council suggests school holidays on 15 and 16 February and occasional days from 17 to 19 February, so that the whole week is off for pupils.",
      "source": "https://www.plymouth.gov.uk/school-term-dates-and-holidays"
    },
    {
      "fact": "Professional development days are allocated by each school from within the term dates, and the calendar counts 190 statutory teaching days.",
      "source": "https://www.plymouth.gov.uk/sites/default/files/2026-08/School-Term-Dates-2026-2027-V3.pdf"
    },
    {
      "fact": "The summer term ends on Monday 26 July 2027, and the spring term starts on Tuesday 5 January 2027.",
      "source": "https://www.plymouth.gov.uk/sites/default/files/2026-08/School-Term-Dates-2026-2027-V3.pdf"
    },
    {
      "fact": "The council's term calendar is organised in six numbered terms, grouped into autumn (terms 1 and 2), spring (3 and 4) and summer (5 and 6).",
      "source": "https://www.plymouth.gov.uk/school-term-dates-and-holidays"
    },
    {
      "fact": "The council has revised its calendars: the 2026-27 PDF on the site is version 3 and the 2027-28 PDF is version 2.",
      "source": "https://www.plymouth.gov.uk/school-term-dates-and-holidays"
    }
  ],
