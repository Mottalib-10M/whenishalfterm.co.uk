  "appliesTo": "Local Authorities set the school working pattern for community and voluntary controlled schools.",
  "academyNote": "We set standard school term dates which we ask Academy, Foundation and Voluntary Aided Wigan schools to follow but they are not obliged to do so.",
  "localFacts": [
    {
      "fact": "Wigan sets a school working pattern of 193 days: 190 pupil days, two fixed inset days and one summer term inset day chosen by schools in their consortia.",
      "source": "https://www.wigan.gov.uk/Resident/Education/Schools/School-term-dates.aspx"
    },
    {
      "fact": "The two fixed inset days fall on the first day of the autumn term and the first day of the spring term.",
      "source": "https://www.wigan.gov.uk/Resident/Education/Schools/School-term-dates.aspx"
    },
    {
      "fact": "Wigan's principles put spring half term in the third full week in February and the Whitsun half term in the last week of May after the bank holiday.",
      "source": "https://www.wigan.gov.uk/Resident/Education/Schools/School-term-dates.aspx"
    },
    {
      "fact": "The council aims for at least a two week Christmas break and a six week summer break wherever possible, and part weeks of no fewer than 3 pupil days.",
      "source": "https://www.wigan.gov.uk/Resident/Education/Schools/School-term-dates.aspx"
    },
    {
      "fact": "In 2026-2027 the spring term starts on Tuesday 5 January 2027, a fixed inset day, and ends on Wednesday 24 March 2027.",
      "source": "https://www.wigan.gov.uk/Docs/PDF/Resident/Education/Schools/School-Working-Pattern-2026-27.pdf"
    },
    {
      "fact": "In 2027-2028 the autumn term starts on Friday 3 September 2027 with a fixed inset day, and February half term is 21 to 25 February 2028.",
      "source": "https://www.wigan.gov.uk/Docs/PDF/Resident/Education/Schools/School-Working-Pattern-2027-28.pdf"
    }
