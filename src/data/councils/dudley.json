  "localFacts": [
    {
      "fact": "Dudley's term dates are proposed jointly with neighbouring West Midlands authorities, including Birmingham, Sandwell, Staffordshire, Walsall, Wolverhampton and Worcestershire, so families across borders share the same holidays.",
