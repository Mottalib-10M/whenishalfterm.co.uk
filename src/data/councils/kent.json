  "localFacts": [
    {"fact": "Kent numbers its year in six terms (Term 1 to Term 6) rather than autumn, spring and summer halves, and publishes the number of school days in each term.", "source": "https://www.kent.gov.uk/__data/assets/pdf_file/0007/196504/Kent-term-dates-2026-27.pdf"},
    {"fact": "The 2026-27 calendar totals 195 days across the six terms (39, 35, 30, 24, 34 and 33 days), described as a standard school year 'with additional INSET days': schools pick their own five non-contact days, so pupils attend 190.", "source": "https://www.kent.gov.uk/__data/assets/pdf_file/0007/196504/Kent-term-dates-2026-27.pdf"},
    {"fact": "Schools may ask teachers to make up the five non-contact days wholly or partly through additional hours before or after sessions, within the 1,265-hour annual limit, instead of closing for full INSET days.", "source": "https://www.kent.gov.uk/__data/assets/pdf_file/0007/196504/Kent-term-dates-2026-27.pdf"},
    {"fact": "In 2027-28 Easter falls late (Easter Sunday 16 April 2028): Term 4 runs to Friday 31 March 2028 and Term 5 starts on Tuesday 18 April 2028, the day after Easter Monday.", "source": "https://www.kent.gov.uk/__data/assets/pdf_file/0003/196509/Kent-term-dates-2027-28.pdf"},
    {"fact": "The 2026-27 PDF lists the May Day bank holiday inside Term 5 as '3/05/2026', a typing slip for Monday 3 May 2027.", "source": "https://www.kent.gov.uk/__data/assets/pdf_file/0007/196504/Kent-term-dates-2026-27.pdf"}
  ],
