  "localFacts": [
    {
      "fact": "Stockport publishes separate summer term dates for primary and secondary schools.",
      "source": "https://www.stockport.gov.uk/school-term-dates"
    },
    {
      "fact": "Primary schools have a two week half term from Monday 31 May to Friday 11 June 2027, while secondary schools return on 7 June.",
      "source": "https://www.stockport.gov.uk/school-term-dates"
    },
    {
      "fact": "Primary term ends on Wednesday 28 July 2027, a week after secondary schools finish on Wednesday 21 July 2027.",
      "source": "https://www.stockport.gov.uk/school-term-dates"
    },
    {
      "fact": "In 2028 the primary half term runs from Monday 29 May to Friday 9 June and primary term ends on Friday 28 July 2028; secondary term ends on Friday 21 July 2028.",
      "source": "https://www.stockport.gov.uk/school-term-dates/2027-to-2028-term-dates"
    },
    {
      "fact": "Voluntary aided schools and schools with Trust or Academy status can set their own calendar.",
      "source": "https://www.stockport.gov.uk/school-term-dates"
    },
    {
      "fact": "The council directs parents to the individual school for term dates and start and finish times.",
      "source": "https://www.stockport.gov.uk/school-term-dates"
    }
  ],
