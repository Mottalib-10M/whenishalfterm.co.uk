  "localFacts": [
    {"fact": "Milton Keynes City Council sets term and holiday dates for community and voluntary controlled schools and maintained nursery schools; governing bodies set them for foundation, trust and voluntary aided schools, free schools and academies.", "source": "https://www.milton-keynes.gov.uk/consultations/consultation-proposed-school-term-dates-20272028"},
    {"fact": "The published dates give 195 days although only 190 term days are required, so each school allocates five training days within them and publishes its own dates on its website.", "source": "https://www.milton-keynes.gov.uk/schools-and-lifelong-learning/information-parents/school-term-dates-september-2026-july-2028"},
    {"fact": "The council consulted on the 2027-28 term dates from 12 January to 22 February 2026.", "source": "https://www.milton-keynes.gov.uk/consultations/consultation-proposed-school-term-dates-20272028"},
    {"fact": "A delegated decision on 17 March 2026 formally adopted the proposed 2027-28 term dates for community and voluntary controlled schools.", "source": "https://www.milton-keynes.gov.uk/consultations/consultation-proposed-school-term-dates-20272028"},
    {"fact": "The council lists, for each half term, the morning schools open and the afternoon session at the end of which they close.", "source": "https://www.milton-keynes.gov.uk/schools-and-lifelong-learning/information-parents/school-term-dates-september-2026-july-2028"},
