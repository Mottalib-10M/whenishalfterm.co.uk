  "appliesTo": "All maintained and voluntary controlled schools in the city follow the dates set by Leicester City Council.",
  "academyNote": "Academies and free schools can set their own term dates.",
  "localFacts": [
    {
      "fact": "Leicester's school year starts in August: schools open on Monday 24 August 2026 and Tuesday 31 August 2027.",
      "source": "https://www.leicester.gov.uk/schools-and-education/term-dates"
    },
    {
      "fact": "The early start pays for an early summer break: the summer holiday begins on Monday 12 July 2027 and Monday 17 July 2028.",
      "source": "https://www.leicester.gov.uk/schools-and-education/term-dates"
    },
    {
      "fact": "The council's calendar marks two INSET days before term opens: Thursday 20 and Friday 21 August 2026, and Thursday 26 and Friday 27 August 2027; schools allocate further INSET days from the pupil days.",
      "source": "https://www.leicester.gov.uk/sites/default/files/2026-03/Leicester%20City%20Council%20school%20term%20and%20holiday%20dates%202026-27_print.pdf"
    },
    {
      "fact": "Leicester uses a six-term year with a one-week October half term, Monday 19 to Friday 23 October 2026, and the autumn second half starting on Monday 26 October.",
      "source": "https://www.leicester.gov.uk/sites/default/files/2026-03/Leicester%20City%20Council%20school%20term%20and%20holiday%20dates%202026-27_print.pdf"
    },
    {
      "fact": "Term dates are reviewed and consulted on every five years; after a public consultation, dates for 2027-28 to 2031-32 have been agreed.",
      "source": "https://www.leicester.gov.uk/schools-and-education/term-dates"
    },
    {
      "fact": "The 2026-27 calendar totals 190 pupil days and the 2027-28 calendar 192 pupil days.",
      "source": "https://www.leicester.gov.uk/sites/default/files/2026-09/Leicester%20city%20council%20school%20term%20and%20holiday%20dates%202027-28_print.pdf"
    }
