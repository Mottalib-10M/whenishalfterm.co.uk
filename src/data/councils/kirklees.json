    },
    {
      "fact": "The council also flags Thursday 4 May 2028 as an election day for schools used as polling stations.",
      "source": "https://www.kirklees.gov.uk/beta/schools/school-term-dates.aspx"
    },
    {
      "fact": "The 2026-27 Easter holiday starts on Good Friday, 26 March 2027, and runs to Friday 9 April 2027.",
