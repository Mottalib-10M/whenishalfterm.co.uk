  "localFacts": [
    {
      "fact": "North Northamptonshire Council sets term dates for community and voluntary controlled schools; five training days are chosen at the discretion of each school.",
      "source": "https://www.northnorthants.gov.uk/schools-and-education/school-term-dates"
    },
    {
      "fact": "The council lists the Spring bank holiday separately and starts the May half term on the Tuesday: Tuesday 1 to Friday 4 June 2027 after the bank holiday on Monday 31 May.",
      "source": "https://www.northnorthants.gov.uk/schools-and-education/school-term-dates"
    },
    {
      "fact": "In 2027-28 North Northamptonshire takes Easter early, from Monday 3 April to Thursday 13 April 2028, with the summer term starting on Tuesday 18 April 2028.",
      "source": "https://www.northnorthants.gov.uk/schools-and-education/school-term-dates"
    },
    {
      "fact": "The 2027-28 autumn term starts on Wednesday 1 September 2027.",
      "source": "https://www.northnorthants.gov.uk/schools-and-education/school-term-dates"
    },
    {
      "fact": "The council gives the summer holiday dates in full, for example Thursday 22 July to Tuesday 31 August 2027.",
      "source": "https://www.northnorthants.gov.uk/schools-and-education/school-term-dates"
    }
  ],
