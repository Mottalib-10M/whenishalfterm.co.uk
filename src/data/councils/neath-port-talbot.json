  "localFacts": [
    {
      "fact": "Neath Port Talbot warns that schools will be closed to pupils for INSET and staff preparation on up to six days in 2026-27, between Tuesday 1 September 2026 and Tuesday 20 July 2027, one more than the usual five.",
      "source": "https://www.npt.gov.uk/schools-and-learning/school-term-dates/"
    },
    {
      "fact": "The council gives every holiday by name, including the summer holiday from Wednesday 21 July to Tuesday 31 August 2027.",
      "source": "https://www.npt.gov.uk/schools-and-learning/school-term-dates/"
    },
    {
      "fact": "Its residents' account, myNPT, shows term dates, INSET days and school dinner menus, and the page offers the holiday calendar as an ICS file.",
      "source": "https://www.npt.gov.uk/schools-and-learning/school-term-dates/"
    },
    {
      "fact": "Christmas 2027 runs from Monday 20 December to Monday 3 January 2028, the New Year bank holiday, with school back on Tuesday 4 January.",
      "source": "https://www.npt.gov.uk/schools-and-learning/school-term-dates/"
    },
    {
      "fact": "In 2027-28 the up to six INSET days fall between Wednesday 1 September 2027 and Thursday 20 July 2028.",
      "source": "https://www.npt.gov.uk/schools-and-learning/school-term-dates/"
    }
  ],
